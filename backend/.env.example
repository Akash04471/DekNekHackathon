# NEXUS JUNCTION — Environment Variables
# Copy this file to .env and fill in your API keys
# All keys are optional — system runs in full mock/simulation mode without them

# OpenWeatherMap API (for live weather data)
OPENWEATHER_API_KEY=

# AI Chatbot — use ONE of these
CLAUDE_API_KEY=
OPENAI_API_KEY=

# Google Maps (for live city map underlay)
GOOGLE_MAPS_API_KEY=

# Server config (defaults work for local dev)
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
